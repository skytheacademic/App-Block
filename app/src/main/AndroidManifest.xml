<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Scanning the stashed key QR at unlock time. Runtime permission — the scan screen asks on
         first use; typing the code stays as the no-camera fallback. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <queries>
        <!-- Launchable apps: the add-an-app picker lists these (Batch 4). Targeted declaration on
             purpose — QUERY_ALL_PACKAGES is a sensitive permission and nothing here needs it. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Enumerate installed web browsers (wildcard http handlers) so any browser NOT on the
             allowlist can be blocked as an app (CONSTRAINTS §2). Android 11+ package visibility. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <!-- Backups are a bypass: snapshot fresh budget state once, restore it whenever blocked.
         allowBackup=false plus explicit exclude-all extraction rules keeps adb backup, cloud
         backup, and Smart Switch device transfer away from the engine's SharedPreferences. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/full_backup_content"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppBlock">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- zxing's scan screen defaults to sensor-landscape; lock it portrait to match the app. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            tools:replace="android:screenOrientation"
            tools:ignore="LockedOrientationActivity,DiscouragedApi" />

        <!-- Not here to police the phone — it asks for no policies at all. An active device admin
             is one of the packages PackageManager refuses to suspend, and suspension is exactly how
             One UI Modes disarms the blocker. See AppBlockDeviceAdminReceiver. -->
        <receiver
            android:name=".service.AppBlockDeviceAdminReceiver"
            android:exported="true"
            android:description="@string/device_admin_description"
            android:label="@string/device_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".service.AppBlockerAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
