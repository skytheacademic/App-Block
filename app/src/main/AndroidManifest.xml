<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the app open the system's "always run in background?" dialog for itself — the one-tap
         repair for a battery exemption that was switched off (audit 2026-08-21, N-3). The exemption
         is the single line of Samsung sleep hardening; without it Deep sleeping apps can stop the
         blocking service and the watchdog with it. Normal-tier permission, granted at install. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Scanning the stashed key QR at unlock time. Runtime permission — the scan screen asks on
         first use; typing the code stays as the no-camera fallback. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Lets the app take itself back out of `accessibility_button_targets`, which is the only way
         that clearing the floating button survives a restart: Android re-derives that setting from
         "enabled service + requests the accessibility button" on every accessibility config read, so
         it rewrites the entry at every boot and a one-shot `settings put` from the cable is undone by
         the next one (reported from the phone 2026-09-08). See service/ShortcutTargetGuard.

         signature|privileged, so it is NOT granted by installing and cannot be reached from any
         Settings screen. It is given once, over adb, and survives reboots and in-place updates:

             adb shell pm grant com.appblock android.permission.WRITE_SECURE_SETTINGS

         Declaring it is what makes that command work at all — `pm grant` refuses a permission the
         package never requested — and declaring it changes nothing on a phone that never runs it:
         every sweep reads NO_PERMISSION and the app behaves as it did before, with the Lock tab
         naming the claim and carrying the command. Lint's ProtectedPermissions warns that normal apps
         cannot hold this; a sideloaded blocker granted it by hand from its owner's laptop is the case
         it does not know about. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <queries>
        <!-- Launchable apps: the add-an-app picker lists these (Batch 4). Targeted declaration on
             purpose — QUERY_ALL_PACKAGES is a sensitive permission and nothing here needs it. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Enumerate installed web browsers (wildcard http handlers) so any browser NOT on the
             allowlist can be blocked as an app (CONSTRAINTS §2). Android 11+ package visibility. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <!-- Backups are a bypass: snapshot fresh budget state once, restore it whenever blocked.
         allowBackup=false plus explicit exclude-all extraction rules keeps adb backup, cloud
         backup, and Smart Switch device transfer away from the engine's SharedPreferences. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/full_backup_content"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppBlock">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- zxing's scan screen defaults to sensor-landscape; lock it portrait to match the app. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            tools:replace="android:screenOrientation"
            tools:ignore="LockedOrientationActivity,DiscouragedApi" />

        <!-- Not here to police the phone — it asks for no policies at all. An active device admin
             is one of the packages PackageManager refuses to suspend, and suspension is exactly how
             One UI Modes disarms the blocker. See AppBlockDeviceAdminReceiver. -->
        <receiver
            android:name=".service.AppBlockDeviceAdminReceiver"
            android:exported="true"
            android:description="@string/device_admin_description"
            android:label="@string/device_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".service.AppBlockerAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
