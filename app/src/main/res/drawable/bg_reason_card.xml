<?xml version="1.0" encoding="utf-8"?>
<!--
  The reason card's ground: the block screen's own room, cut down to a card that sits on the home
  screen. A hairline in the row-rule colour keeps its edge visible over a dark wallpaper.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/lamp_block_ground" />
    <stroke android:width="1dp" android:color="@color/lamp_row_rule" />
    <corners android:radius="16dp" />
</shape>
