    <color name="lamp_text">#EFE7DC</color>
    <color name="lamp_accent">#D9A05C</color>
    <color name="lamp_neutral_400">#C8BDAE</color>
    <color name="lamp_neutral_500">#A5988A</color>
    <color name="lamp_row_rule">#14EFE7DC</color>
