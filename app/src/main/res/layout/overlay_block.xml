<?xml version="1.0" encoding="utf-8"?>
<!--
  The block screen. A deeper room than the app (#120E0A vs the app's #17130F), so being blocked does
  not look like being in the app — this is the one surface you meet when you have already lost the
  argument with yourself, and it should feel like somewhere else.

  Left-aligned and vertically centred rather than centred-centred: centred text reads as a dialog
  asking something, and this is not asking.

  The two fact rows below the rule answer the two questions every block raises — **when it lifts on
  its own** and **the way through** — and both are facts about *this* block, filled in by the service
  from com.appblock.engine.BlockFacts. They used to be hard-coded here as "constants of the system"
  (`day resets 04:00` / `more time 1-hour wait`), which was true of a budget block and wrong about
  every other kind: a schedule block is not waiting on 04:00, and no exception wait moves it at all.
  See BlockFacts for the full account.

  The block's own reason stays in @id/block_message, which the service sets from the reason-aware
  string set (block_message_budget / _schedule / _tamper / _site / _browser). The contract this layout
  has with service/ is six ids: block_message, block_close, and the four fact TextViews. The strings
  left in here are what a preview renders and what a failed lookup would show — never what ships.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@color/lamp_block_ground"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/block_title"
        android:textColor="@color/lamp_text"
        android:textSize="60sp"
        android:fontFamily="@font/inter_medium"
        android:letterSpacing="-0.035"
        android:lineSpacingMultiplier="0.98"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/block_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/block_message"
        android:textColor="@color/lamp_neutral_400"
        android:textSize="15sp"
        android:fontFamily="@font/inter_regular" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/block_rule" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="11dp"
        android:paddingBottom="11dp">

        <TextView
            android:id="@+id/block_fact_when_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/block_fact_when_resets"
            android:textColor="@color/lamp_neutral_500"
            android:textSize="12.5sp"
            android:fontFamily="@font/inter_regular" />

        <TextView
            android:id="@+id/block_fact_when_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/block_fact_no_hours"
            android:textColor="@color/lamp_text"
            android:textSize="12.5sp"
            android:fontFamily="@font/inter_regular"
            android:fontFeatureSettings="tnum" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/lamp_row_rule" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="11dp"
        android:paddingBottom="11dp">

        <TextView
            android:id="@+id/block_fact_route_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/block_fact_route_more_time"
            android:textColor="@color/lamp_neutral_500"
            android:textSize="12.5sp"
            android:fontFamily="@font/inter_regular" />

        <TextView
            android:id="@+id/block_fact_route_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/block_fact_not_from_phone"
            android:textColor="@color/lamp_neutral_400"
            android:textSize="12.5sp"
            android:fontFamily="@font/inter_regular" />
    </LinearLayout>

    <!--
      Explicit AppCompatButton, not <Button>: a Material theme's view inflater would swap a bare
      <Button> for a MaterialButton, which owns its own background and would quietly drop the accent
      outline below. The service does findViewById<Button>, which this still satisfies.
    -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/block_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:minWidth="0dp"
        android:minHeight="42dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:background="@drawable/bg_button_outline_accent"
        android:text="@string/block_go_back"
        android:textAllCaps="false"
        android:textColor="@color/lamp_accent"
        android:textSize="14sp"
        android:fontFamily="@font/inter_medium"
        android:stateListAnimator="@null" />
</LinearLayout>
