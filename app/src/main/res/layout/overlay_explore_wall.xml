<?xml version="1.0" encoding="utf-8"?>
<!--
  The wall over Instagram's Explore grid while the Reels + Explore pool is spent: see
  com.appblock.engine.ExploreWall. Same deep ground as the block screen, because it is the same
  argument, but it is a panel inside Instagram rather than a room of its own: the window is sized to
  start under the search bar and stop at the tab bar.

  Clickable, so a touch on the panel stops here instead of opening a thumbnail. There is no Close: the
  way past it is Instagram's own search bar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="Overdraw"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@color/lamp_block_ground"
    android:clickable="true"
    android:focusable="false"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/explore_wall_title"
        android:textColor="@color/lamp_text"
        android:textSize="30sp"
        android:fontFamily="@font/inter_medium"
        android:letterSpacing="-0.02"
        android:includeFontPadding="false" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/explore_wall_search"
        android:textColor="@color/lamp_neutral_400"
        android:textSize="15sp"
        android:fontFamily="@font/inter_regular" />
</LinearLayout>
