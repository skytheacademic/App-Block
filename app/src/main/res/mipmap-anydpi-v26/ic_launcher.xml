<?xml version="1.0" encoding="utf-8"?>
<!--
  "Ration": four bars tapering down, echoing the seven-day strip inside the app. It reads as a budget
  rather than as a clock — which is what this is.

  <monochrome> is the themed-icon layer (Android 13+, so One UI 8 uses it): one colour, with alpha
  carrying the taper.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
